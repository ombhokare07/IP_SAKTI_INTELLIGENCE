APP_NAME=IP-SAKTI Intelligence
APP_ENV=development
DEBUG=false
APP_DATA_DIR=./data/runtime

# Application access (local development defaults to loopback with auth optional).
# Production requires a nonempty API_AUTH_TOKEN, even if API_AUTH_REQUIRED=false.
API_AUTH_REQUIRED=false
API_AUTH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a high-entropy secret for production; never expose it to the frontend.
SESSION_SECRET=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Original Phase-1 RAG. Missing key keeps the original /api/chat route unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
VECTOR_DB_PATH=./chroma_db
VECTOR_COLLECTION=ip_sakti_documents
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
EVIDENCE_RELEVANCE_THRESHOLD=0.55
EVIDENCE_SUFFICIENCY_THRESHOLD=0.55
EVIDENCE_MIN_RELEVANT_CHUNKS=1

# Blank, epo_ops, http_json, or explicitly enabled mock.
PRIOR_ART_PROVIDER=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
PRIOR_ART_API_URL=
PRIOR_ART_API_KEY=
PRIOR_ART_TIMEOUT=15
PRIOR_ART_CACHE_TTL=900
PRIOR_ART_ALLOW_MOCK=false

# Explicit fixture opt-in; production always disables fixtures.
ALLOW_MOCK_DATA=false
PROVIDER_TIMEOUT=15

# Blank, local, mock or http_json. Omit corpus path until a real local corpus exists.
TK_PROVIDER=
# TK_CORPUS_PATH=./data/authorized/tk.json
TK_API_URL=
TK_API_KEY=
TK_SEARCH_AUTHORIZED=false

REGULATION_PROVIDER=
# REGULATION_CORPUS_PATH=./data/authorized/regulations.json
REGULATION_API_URL=
REGULATION_API_KEY=

# Blank or http_json. Each URL is an operator-managed gateway, not an authority API.
TRANSLATION_PROVIDER=
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
STT_PROVIDER=
STT_API_URL=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_URL=
TTS_API_KEY=
