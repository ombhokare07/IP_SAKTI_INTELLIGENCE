FROM python:3.11-slim
WORKDIR /app
ARG INSTALL_FULL=false
COPY requirements.txt requirements-offline.txt ./
RUN if [ "$INSTALL_FULL" = "true" ]; then pip install --no-cache-dir -r requirements.txt; else pip install --no-cache-dir -r requirements-offline.txt; fi
COPY . .
RUN useradd --create-home appuser && mkdir -p /app/data/runtime /app/chroma_db && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
